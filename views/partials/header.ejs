<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %></title>
  <meta name="description" content="Book private Jordan tours, airport transfers, border transportation, and customized trips to Petra, Wadi Rum, Jerash, Aqaba, Umm Qais, and destinations across Jordan.">
  <link rel="canonical" href="<%= siteUrl %><%= page === 'home' ? '/' : `/${page}` %>">
  <meta property="og:type" content="website"><meta property="og:title" content="<%= title %>">
  <meta property="og:description" content="Private Jordan tours, airport transfers, border transportation, and customized trips.">
  <meta property="og:url" content="<%= siteUrl %><%= page === 'home' ? '/' : `/${page}` %>">
  <meta property="og:image" content="<%= siteUrl %>/images/petra-hero.jpg">
  <meta name="twitter:card" content="summary_large_image">
  <link rel="icon" href="/images/favicon.svg" type="image/svg+xml">
  <link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600;700&family=Manrope:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/styles.css">
  <script defer src="/js/lucide.min.js"></script>
  <script defer src="/js/main.js"></script>
  <% if (page === 'home') { %><script defer src="/js/contact-form.js"></script><% } %>
</head>
<body class="page-<%= page %>">
  <a class="skip-link" href="#main">Skip to content</a>
  <header class="site-header<%= page !== 'home' ? ' is-scrolled' : '' %>" data-header>
    <div class="header-inner">
      <a class="brand" href="/#home" aria-label="Jordan Elite home">
        <img src="/images/jordan-elite-logo.png" alt="Jordan Elite" width="148" height="72">
      </a>
      <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-nav" aria-label="Open navigation menu" data-menu-toggle>
        <span></span><span></span><span></span>
      </button>
      <nav id="site-nav" class="site-nav" aria-label="Main navigation" data-nav>
        <a href="/#home">Home</a><a href="/#services">Services</a><a href="/#destinations">Destinations</a><a href="/#tours">Tours</a><a href="/#why-us">Why Us</a><a href="/#faq">FAQ</a><a href="/#contact">Contact</a>
      </nav>
      <a class="button button-small header-cta" href="/#contact">Plan Your Tour</a>
    </div>
  </header>
